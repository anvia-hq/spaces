{
  "name": "@spaces/api",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "agent": "bun run src/agent.ts",
    "dev:agent": "bun run --watch src/agent.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:guest": "SPACES_IT=1 bun test src/modules/driver/guest.test.ts",
    "auth:schema": "SPACES_DRIVER=mock bun x --bun auth@latest generate --config ./src/modules/auth/service.ts --output ../../packages/db/src/auth-schema.ts --yes"
  },
  "dependencies": {
    "@better-auth/api-key": "^1.7.25",
    "@hono/zod-validator": "^0.9.1",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/context-async-hooks": "^1.30.0",
    "@opentelemetry/core": "^1.30.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.57.0",
    "@opentelemetry/resources": "^1.30.0",
    "@opentelemetry/sdk-trace-base": "^1.30.0",
    "@spaces/db": "workspace:*",
    "@spaces/shared": "workspace:*",
    "better-auth": "^1.7.25",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.6.14",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.3"
  }
}
