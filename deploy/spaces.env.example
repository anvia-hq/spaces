# spaces runtime configuration — installed to /etc/spaces/spaces.env (0600, root).
# systemd reads this before dropping privileges, so the API key need not be
# readable by the service user.

PORT=8787

# Loopback: `tailscale serve` terminates TLS on 443 and proxies here, so there is
# no plaintext listener on any interface and the browser gets a real certificate
# on a MagicDNS name. The API executes code on request, so this is the intended
# exposure — ufw (INPUT DROP) is the second layer.
# Without a tailnet: SPACES_BIND=0.0.0.0 (behind a firewall) or 127.0.0.1 (proxy).
SPACES_BIND=127.0.0.1

# Control plane and runner are the same machine: no SSH hop, 20-24 ms per call.
SPACES_DRIVER=microsandbox
SPACES_MSB_HOST=local
SPACES_MSB=@HOME@/.microsandbox/bin/msb
# alpine is tiny but has no glibc/curl/git/procps. For a session that starts
# useful, build deploy/guest/Dockerfile and use the ready image instead:
#   docker build -t spaces/guest:ubuntu -f deploy/guest/Dockerfile .
#   docker save spaces/guest:ubuntu | msb load -t spaces/guest:ubuntu
# SPACES_MSB_IMAGE=spaces/guest:ubuntu
#
# For an agent/web session, build the starter image on top of it instead. It
# adds Node 26 (nvm), bun, uv/uvx, gh and Playwright + Chromium, so the first
# command does not wait on an install. It is ~0.9 GB and ~2.5 min to build once:
#   docker build -t spaces/guest:starter -f deploy/guest/Dockerfile.starter .
#   docker save spaces/guest:starter | msb load -t spaces/guest:starter
# See docs/decision/0035-starter-guest-image.md.
SPACES_MSB_IMAGE=spaces/guest:starter

# The operator key: one bearer token that sees and does everything, including
# sandboxes that belong to user accounts. Kept for existing clients (Aven sends
# one) and for a fresh install. Set it empty to turn it off and allow only
# sessions and user API keys.
SPACES_API_KEY=CHANGE_ME
# Postgres (decision 0030). The deploy script creates the role and database and
# generates the password; nothing here needs to be filled in by hand.
SPACES_DATABASE_URL=postgres://spaces:CHANGE_ME@127.0.0.1:5432/spaces

# Better Auth: sessions for the console plus per-user API keys. The secret signs
# both; the deploy script generates it once and never rotates it by itself.
# Rotating it signs everybody out. 32+ characters, e.g. `openssl rand -base64 48`.
SPACES_AUTH_SECRET=CHANGE_ME_at_least_32_characters_long
# Public origin of the API. Cookies and the origin check are tied to it.
SPACES_AUTH_URL=https://your-host.your-tailnet.ts.net
# Extra origins allowed to post to /api/auth. The console's dev server by
# default; the API's own origin is always trusted.
# SPACES_AUTH_TRUSTED_ORIGINS=http://localhost:5173
# SPACES_AUTH_SESSION_DAYS=30
# SPACES_API_KEY_PREFIX=spk_
# SPACES_AUTH_DEBUG=1

# The bootstrap for the first admin, comma separated and empty by default
# (decision 0037). An address on this list becomes an admin at boot if its
# account already exists, and otherwise the first time it signs in or signs up.
# Once one admin exists they promote the rest from the console (Members), so
# this can be emptied again: it never demotes anybody, and emptying it is the
# point at which the deployment is managed by its own admins rather than by a
# restart. Keep the operator key for machines and existing clients.
# SPACES_ADMIN_EMAILS=you@example.com

# "Continue with GitHub" (decision 0036). Set both halves of a GitHub OAuth app
# and the button appears; leave either unset and the provider is not registered
# at all (email + password always works). Register the app's callback URL as
# SPACES_AUTH_URL + /api/auth/callback/github, e.g.
#   https://your-host.your-tailnet.ts.net/api/auth/callback/github
# SPACES_GITHUB_CLIENT_ID=
# SPACES_GITHUB_CLIENT_SECRET=

# The built console, served by the API itself — one process, one port, and no
# reverse proxy that could forward /api but forget /health.
SPACES_WEB_ROOT=@HOME@/spaces/apps/web/dist

# Origin used when minting signed transfer and preview URLs. Must match what the
# browser sees, or every download and preview link points at the wrong scheme.
SPACES_PUBLIC_URL=https://your-host.your-tailnet.ts.net

# Tracing (decision 0032). Spans live in Postgres; set the endpoint to also
# ship them to a collector. 0 keeps them forever.
# SPACES_TRACE_RETENTION_DAYS=7
# SPACES_OTLP_ENDPOINT=http://127.0.0.1:4318/v1/traces

# 16 cores / 31 GiB. Sandboxes default to 2 vCPU / 4 GiB, so 8 is the point at
# which memory runs out before the admission limit does.
SPACES_MAX_SANDBOXES=8

# `public` permits public addresses and denies private ones (LAN, tailnet).
# Widen it narrowly with rules rather than switching to `all`:
SPACES_NET=public
# SPACES_NET_RULES=allow@192.168.1.50,allow@100.104.164.110:tcp:8443
SPACES_PORT_BIND=127.0.0.1
SPACES_PREPUBLISH_PORTS=3000,3001,4000,5000,5173,8000,8080,8888
SPACES_TRANSFER_MAX=104857600